{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feishu-intent topics.json（宿主大模型步骤的输出约定）",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "no",
          "title",
          "summary",
          "kind",
          "task_type",
          "assignees",
          "reviewers",
          "consultees",
          "review_criteria",
          "ddl_by_person",
          "date",
          "date_basis",
          "ddl",
          "ddl_basis",
          "remind",
          "remind_basis",
          "priority",
          "labels",
          "links",
          "refs",
          "refs_reason",
          "subtasks",
          "note",
          "written"
        ],
        "properties": {
          "no": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "task",
              "info"
            ],
            "description": "task=含执行任务（有事要人去办，含征集意见、没人认领的活；拿不准时选 task）；info=纯资讯，只限通知、公告等无需任何行动的消息（不能有执行员、子任务、截止）"
          },
          "task_type": {
            "enum": [
              "personal",
              "team",
              "undetermined",
              null
            ],
            "description": "personal=个人任务（执行员恰好 1 人）；team=团队任务；undetermined=判断不了（卡片显示「（待定）」），推断不出办理人时用它"
          },
          "assignees": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "open_id",
                "basis",
                "evidence"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "姓名；用户本人写 {display_name} 以外的真实称呼也可，显示时一律换成 display_name"
                },
                "open_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^ou_",
                  "description": "messages.json 里能对上的 open_id（mentions、发言人）；对不上写 null。只有 open_id 等于用户本人的才算用户，没有 open_id 的人永远不是用户"
                },
                "basis": {
                  "enum": [
                    "quote",
                    "role"
                  ],
                  "description": "quote=原话点名（另给 message_id，消息须列在 links 里）；role=按角色推断（用户本人时 evidence 必须是 config user.roles 里的角色）。reply 只由程序在「升格 #N」时写入；role 只允许用户本人是唯一执行员且原话没点名任何执行员时使用。rule（审批人）只由程序推导，宿主写了即拒绝"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "quote 时为该消息原话片段；role 时为角色名"
                },
                "message_id": {
                  "type": "string"
                }
              }
            },
            "description": "执行员，可多人；推断不出办理人就留空（卡片显示「（办理人待定）」，照常出卡，用户按规则为审批人），严禁默认填用户本人"
          },
          "reviewers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "open_id",
                "basis",
                "evidence"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "姓名；用户本人写 {display_name} 以外的真实称呼也可，显示时一律换成 display_name"
                },
                "open_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^ou_",
                  "description": "messages.json 里能对上的 open_id（mentions、发言人）；对不上写 null。只有 open_id 等于用户本人的才算用户，没有 open_id 的人永远不是用户"
                },
                "basis": {
                  "enum": [
                    "quote"
                  ],
                  "description": "只能 quote（原话 @ 或点名，另给 message_id，消息须列在 links 里）；评审员、咨询对象不能按角色推断。rule（审批人）只由程序推导，宿主写了即拒绝"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "quote 时为该消息原话片段；role 时为角色名"
                },
                "message_id": {
                  "type": "string"
                }
              }
            },
            "description": "评审员，有序，顺序即评审顺序（执行员 -> 第一位 -> 第二位）"
          },
          "consultees": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "open_id",
                "basis",
                "evidence"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "姓名；用户本人写 {display_name} 以外的真实称呼也可，显示时一律换成 display_name"
                },
                "open_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^ou_",
                  "description": "messages.json 里能对上的 open_id（mentions、发言人）；对不上写 null。只有 open_id 等于用户本人的才算用户，没有 open_id 的人永远不是用户"
                },
                "basis": {
                  "enum": [
                    "quote"
                  ],
                  "description": "只能 quote（原话 @ 或点名，另给 message_id，消息须列在 links 里）；评审员、咨询对象不能按角色推断。rule（审批人）只由程序推导，宿主写了即拒绝"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "quote 时为该消息原话片段；role 时为角色名"
                },
                "message_id": {
                  "type": "string"
                }
              }
            },
            "description": "咨询对象"
          },
          "review_criteria": {
            "type": [
              "string",
              "null"
            ],
            "description": "评审标准，原文没有就 null"
          },
          "ddl_by_person": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "person",
                "date",
                "basis"
              ],
              "properties": {
                "person": {
                  "type": "string",
                  "description": "必须是上面某个角色成员的 name"
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "description": "按人分别写的 DDL"
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "哪天做；null 时 date_basis 必填"
          },
          "date_basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "ddl": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "截止；不论是否为 null，ddl_basis 都必填"
          },
          "ddl_basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "remind": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$",
            "description": "北京时间；null 时 remind_basis 必填"
          },
          "remind_basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4",
              null
            ]
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "只放业务标签（写进描述）；优先级标签由程序推导，写了「紧急重要」等或「跟进」会被拒绝"
          },
          "actions": {
            "type": "array",
            "items": {
              "enum": [
                "执行",
                "评审",
                "问询",
                "指派"
              ]
            },
            "uniqueItems": true,
            "description": "可不写，由程序推导：用户有原话角色就用角色（执行员→执行，评审员→评审，咨询对象→问询）；否则任务条目由程序把用户设为审批人，行动「指派」；纯资讯为空。写了就必须与推导一致"
          },
          "links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "message_id",
                "quote"
              ],
              "properties": {
                "message_id": {
                  "type": "string",
                  "description": "必须出现在 messages.json 里"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "该消息原话摘录"
                }
              }
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "关联的其他条目，如 #6、F3；没有证据就留空"
          },
          "refs_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "refs 非空时必填，且须含用「」括起的原话证据"
          },
          "subtasks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "written": {
            "type": "boolean",
            "description": "固定 false；是否写入只由用户确认决定"
          }
        }
      }
    }
  }
}
